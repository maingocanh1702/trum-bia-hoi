<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maingocanh.ap-watch.trumbiahoi</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/maingocanh/Projects/Trum Bia Hoi/scripts/ap-watch.sh</string>
    <string>30</string>
    <string>8</string>
  </array>

  <!-- chạy ngay khi load + giữ sống (tự restart nếu crash/exit) -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- log riêng -->
  <key>StandardOutPath</key>
  <string>/tmp/ap-watch-trumbiahoi.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ap-watch-trumbiahoi.err</string>

  <!-- chạy trong GUI session của user → osascript notification hiển thị được -->
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
