{
  "name": "trum-bia-hoi",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "description": "Root: gate check:config (JSON ↔ registry) + npm workspaces cho game mới (packages/engine, apps/web, apps/server). prototype/ là lưu trữ, không thuộc workspace.",
  "scripts": {
    "check:economy": "python3 scripts/check_economy_config.py",
    "check:config-coverage": "python3 scripts/check_config_coverage.py",
    "check:config": "npm run check:economy && npm run check:config-coverage",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/engine/test/*.test.ts apps/server/test/*.test.ts",
    "test:server": "tsx --test apps/server/test/*.test.ts",
    "sim": "tsx packages/engine/sim/headless.ts",
    "sim:onboarding": "tsx packages/engine/sim/headless.ts --onboarding-pair",
    "verify": "npm run check:config && npm run check:i18n && npm run build && npm test && npm run sim:onboarding && npm run sim:rush && npm run sim:career:gate",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config playwright.accessibility.config.ts",
    "check:i18n": "node scripts/check_web_copy.mjs",
    "check:assets": "python3 scripts/check_assets.py",
    "sim:rush": "tsx packages/engine/sim/rush-pressure.ts",
    "dev:server": "tsx apps/server/src/main.ts",
    "sim:career": "tsx packages/engine/sim/career.ts",
    "sim:career:gate": "tsx packages/engine/sim/career.ts --check-advanced",
    "test:one": "node --import tsx --test",
    "verify:port": "node --import tsx scripts/verify/port.ts",
    "verify:map": "node --import tsx scripts/verify/map-coverage.ts",
    "verify:doctor": "node --import tsx scripts/verify/doctor.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
